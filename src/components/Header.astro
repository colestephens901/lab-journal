---
import '../styles/global.css';

const pathname = Astro.url.pathname;

const navItems = [
	{ name: 'Home', href: '/' },
	{ name: 'Lab Journal', href: '/blog/' },
	{ name: 'Projects', href: '/projects/' },
	{ name: 'About', href: '/about/' },
];

function isActive(href: string) {
	if (href === '/') {
		return pathname === '/';
	}

	return pathname.startsWith(href);
}
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/" aria-label="Cole Stephens Lab Journal home">
			<span class="terminal-mark">&gt;_</span>

			<span class="brand-text">
				<strong>Cole Stephens</strong>
				<span>Lab Journal</span>
			</span>
		</a>

		<nav aria-label="Main navigation">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={['nav-link', { active: isActive(item.href) }]}
					>
						{item.name}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		background: rgba(9, 13, 19, 0.88);
		backdrop-filter: blur(14px);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;

		width: min(var(--max-width), calc(100% - 40px));
		min-height: 72px;
		margin: 0 auto;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.8rem;

		color: var(--text-strong);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--text-strong);
	}

	.terminal-mark {
		display: grid;
		width: 38px;
		height: 38px;
		place-items: center;

		border: 1px solid rgba(56, 189, 248, 0.35);
		border-radius: 8px;

		background: var(--accent-soft);
		color: var(--accent);

		font-family: Consolas, monospace;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}

	.brand-text strong {
		font-size: 0.95rem;
	}

	.brand-text span {
		margin-top: 0.15rem;
		color: var(--muted);
		font-family: Consolas, monospace;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.09em;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.nav-link {
		position: relative;
		padding: 0.55rem 0.8rem;
		border-radius: 7px;

		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;

		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	.nav-link:hover {
		background: var(--bg-elevated);
		color: var(--text-strong);
	}

	.nav-link.active {
		background: var(--accent-soft);
		color: var(--accent);
	}

	@media (max-width: 700px) {
		.header-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.8rem;
			padding: 0.9rem 0;
		}

		nav {
			width: 100%;
			overflow-x: auto;
		}

		.nav-link {
			white-space: nowrap;
		}
	}
</style>