---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About | Cole Stephens"
			description="About Cole Stephens, an IT student and field technician focused on systems administration, networking, Linux, virtualization, and infrastructure."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="about-hero">
				<div class="hero-copy">
					<p class="eyebrow">ABOUT ME</p>

					<h1>
						Learning infrastructure
						<span>by actually running it.</span>
					</h1>

					<p class="intro">
						I'm Cole Stephens, an IT student and field technician building
						hands-on experience with systems administration, networking,
						Linux, virtualization, automation, and self-hosted infrastructure.
					</p>

					<p class="intro secondary">
						My homelab gives me a place to work through the same kinds of
						problems that make infrastructure interesting: failed services,
						network segmentation, DNS problems, storage design, monitoring,
						backups, remote access, automation, and the occasional configuration
						that doesn't survive first contact with reality.
					</p>
				</div>

				<div class="profile-terminal">
					<div class="terminal-top">
						<span></span>
						<span></span>
						<span></span>

						<p>cole@lab:~</p>
					</div>

					<div class="terminal-body">
						<p>
							<span class="prompt">$</span>
							cat profile.txt
						</p>

						<div class="output">
							<p>
								<span>role:</span>
								Field Technician
							</p>

							<p>
								<span>education:</span>
								Information Technology
							</p>

							<p>
								<span>focus:</span>
								Systems & Infrastructure
							</p>

							<p>
								<span>learning:</span>
								CompTIA A+ / Network+
							</p>

							<p>
								<span>lab_status:</span>
								<strong>online</strong>
							</p>
						</div>

						<p class="last-line">
							<span class="prompt">$</span>
							<span class="cursor">_</span>
						</p>
					</div>
				</div>
			</section>

			<section class="story">
				<div class="section-title">
					<p class="section-label">BACKGROUND</p>
					<h2>From troubleshooting devices to infrastructure.</h2>
				</div>

				<div class="story-copy">
					<p>
						My professional background is rooted in hands-on technology
						support and troubleshooting. Working directly with customers,
						devices, networks, and real-world technical problems pushed me
						toward the infrastructure side of IT.
					</p>

					<p>
						That interest eventually grew into a home lab where I could move
						beyond individual devices and work with complete systems:
						virtualization hosts, firewalls, VLANs, storage, Linux servers,
						containers, monitoring platforms, VPNs, DNS, and automation.
					</p>

					<p>
						I use the lab as both infrastructure and a learning environment.
						If I want to understand a technology, I prefer to deploy it,
						configure it, break it, troubleshoot it, document it, and then
						improve the design.
					</p>
				</div>
			</section>

			<section class="focus-section">
				<div class="section-heading">
					<div>
						<p class="section-label">TECHNICAL FOCUS</p>
						<h2>Areas I'm developing.</h2>
					</div>

					<p>
						The technologies change over time, but the focus remains on
						understanding how infrastructure actually works.
					</p>
				</div>

				<div class="focus-grid">
					<article>
						<span class="number">01</span>

						<h3>Systems Administration</h3>

						<p>
							Linux administration, service deployment, virtualization,
							system troubleshooting, backups, storage, and infrastructure
							maintenance.
						</p>

						<div class="tags">
							<span>Linux</span>
							<span>Debian</span>
							<span>Proxmox</span>
							<span>LXC</span>
							<span>ZFS</span>
						</div>
					</article>

					<article>
						<span class="number">02</span>

						<h3>Networking</h3>

						<p>
							Routing, switching, VLAN segmentation, firewall policy,
							DNS, DHCP, VPN connectivity, and network troubleshooting.
						</p>

						<div class="tags">
							<span>OPNsense</span>
							<span>VLANs</span>
							<span>DNS</span>
							<span>VPN</span>
							<span>Firewall</span>
						</div>
					</article>

					<article>
						<span class="number">03</span>

						<h3>Observability</h3>

						<p>
							Collecting metrics, monitoring services, visualizing system
							health, identifying failures, and building useful alerting.
						</p>

						<div class="tags">
							<span>Prometheus</span>
							<span>Grafana</span>
							<span>Uptime Kuma</span>
							<span>Node Exporter</span>
						</div>
					</article>

					<article>
						<span class="number">04</span>

						<h3>Automation & Self-Hosting</h3>

						<p>
							Containerized applications, reverse proxies, infrastructure
							automation, smart-home integrations, scripting, and reusable
							deployment workflows.
						</p>

						<div class="tags">
							<span>Docker</span>
							<span>Compose</span>
							<span>Home Assistant</span>
							<span>Nginx</span>
						</div>
					</article>
				</div>
			</section>

			<section class="approach">
				<div>
					<p class="section-label">HOW I WORK</p>

					<h2>
						Troubleshoot first.
						<br />
						Document what mattered.
					</h2>
				</div>

				<div class="approach-list">
					<div>
						<span>01</span>
						<section>
							<h3>Understand the problem</h3>
							<p>
								Start with the actual symptoms and verify assumptions before
								changing the configuration.
							</p>
						</section>
					</div>

					<div>
						<span>02</span>
						<section>
							<h3>Work from evidence</h3>
							<p>
								Use logs, metrics, command output, documentation, and controlled
								testing to narrow down the cause.
							</p>
						</section>
					</div>

					<div>
						<span>03</span>
						<section>
							<h3>Understand the fix</h3>
							<p>
								Getting something working is useful. Understanding why it
								worked is what makes the solution reusable.
							</p>
						</section>
					</div>

					<div>
						<span>04</span>
						<section>
							<h3>Leave documentation behind</h3>
							<p>
								Record the architecture, important decisions, problems
								encountered, and lessons learned for the next time.
							</p>
						</section>
					</div>
				</div>
			</section>

			<section class="cta">
				<p class="section-label">EXPLORE THE LAB</p>

				<h2>See what I'm building.</h2>

				<p>
					The Projects page contains selected infrastructure work, while the
					Lab Journal follows the ongoing troubleshooting and learning process.
				</p>

				<div class="actions">
					<a class="primary-button" href="/projects/">
						View Projects
						<span aria-hidden="true">→</span>
					</a>

					<a class="secondary-button" href="/blog/">
						Read the Lab Journal
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.about-hero {
		display: grid;
		grid-template-columns: 1.35fr 0.8fr;
		gap: 5rem;
		align-items: center;

		padding: 7rem 0;
	}

	.eyebrow,
	.section-label {
		margin: 0 0 1rem;

		color: var(--accent);

		font-family: Consolas, monospace;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	h1 {
		max-width: 850px;
		margin: 0;

		font-size: clamp(3.5rem, 7vw, 6rem);
		line-height: 0.97;
		letter-spacing: -0.055em;
	}

	h1 span {
		display: block;
		color: #a6b6c9;
	}

	.intro {
		max-width: 760px;
		margin: 2rem 0 0;

		color: var(--muted);

		font-size: 1.12rem;
		line-height: 1.8;
	}

	.intro.secondary {
		margin-top: 1.2rem;
		font-size: 1rem;
	}

	.profile-terminal {
		overflow: hidden;

		border: 1px solid var(--border);
		border-radius: 12px;

		background: #060a0f;

		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
	}

	.terminal-top {
		display: flex;
		align-items: center;
		gap: 0.45rem;

		padding: 0.8rem 1rem;

		border-bottom: 1px solid var(--border);

		background: #0d131c;
	}

	.terminal-top > span {
		width: 9px;
		height: 9px;

		border-radius: 50%;

		background: #374151;
	}

	.terminal-top p {
		margin: 0 0 0 auto;

		color: #617086;

		font-family: Consolas, monospace;
		font-size: 0.68rem;
	}

	.terminal-body {
		min-height: 340px;
		padding: 1.5rem;

		font-family: Consolas, "Courier New", monospace;
		font-size: 0.82rem;
	}

	.terminal-body > p {
		margin: 0 0 1.4rem;
	}

	.prompt {
		color: var(--accent);
	}

	.output {
		padding-left: 1.2rem;
	}

	.output p {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 0.8rem;

		margin: 0 0 0.75rem;

		color: #b7c4d3;
	}

	.output p span {
		color: #66778b;
	}

	.output strong {
		color: var(--success);
		font-weight: 400;
	}

	.last-line {
		margin-top: 1.7rem !important;
	}

	.cursor {
		color: var(--accent);

		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.story {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 6rem;

		padding: 6rem 0;

		border-top: 1px solid var(--border);
	}

	.section-title h2,
	.section-heading h2,
	.approach h2,
	.cta h2 {
		margin: 0;

		font-size: clamp(2rem, 4vw, 3rem);
		letter-spacing: -0.035em;
	}

	.story-copy {
		color: var(--muted);

		font-size: 1.05rem;
		line-height: 1.85;
	}

	.story-copy p:first-child {
		margin-top: 0;
	}

	.focus-section {
		padding: 6rem 0;
		border-top: 1px solid var(--border);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 3rem;

		margin-bottom: 2rem;
	}

	.section-heading > p {
		max-width: 430px;
		margin: 0;

		color: var(--muted);
	}

	.focus-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.focus-grid article {
		padding: 1.8rem;

		border: 1px solid var(--border);
		border-radius: 12px;

		background: var(--bg-elevated);
	}

	.number {
		display: block;

		margin-bottom: 2.5rem;

		color: var(--accent);

		font-family: Consolas, monospace;
		font-size: 0.72rem;
	}

	.focus-grid h3 {
		margin: 0 0 0.7rem;

		font-size: 1.45rem;
	}

	.focus-grid article > p {
		margin: 0;

		color: var(--muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;

		margin-top: 1.4rem;
	}

	.tags span {
		padding: 0.25rem 0.45rem;

		border: 1px solid var(--border);
		border-radius: 5px;

		background: var(--bg-soft);
		color: #aebdd0;

		font-family: Consolas, monospace;
		font-size: 0.68rem;
	}

	.approach {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 6rem;

		padding: 6rem 0;

		border-top: 1px solid var(--border);
	}

	.approach-list {
		border-top: 1px solid var(--border);
	}

	.approach-list > div {
		display: grid;
		grid-template-columns: 50px 1fr;
		gap: 1rem;

		padding: 1.5rem 0;

		border-bottom: 1px solid var(--border);
	}

	.approach-list > div > span {
		color: var(--accent);

		font-family: Consolas, monospace;
		font-size: 0.72rem;
	}

	.approach-list section {
		margin: 0;
	}

	.approach-list h3 {
		margin: 0 0 0.4rem;

		font-size: 1.05rem;
	}

	.approach-list p {
		margin: 0;

		color: var(--muted);
	}

	.cta {
		padding: 7rem 0;

		border-top: 1px solid var(--border);
	}

	.cta > p:not(.section-label) {
		max-width: 650px;

		color: var(--muted);

		font-size: 1.05rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;

		margin-top: 2rem;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;

		min-height: 46px;
		padding: 0.7rem 1.1rem;

		border-radius: 8px;

		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;

		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.actions a:hover {
		transform: translateY(-2px);
	}

	.primary-button {
		border: 1px solid var(--accent);

		background: var(--accent);
		color: #061018;
	}

	.primary-button:hover {
		background: var(--accent-hover);
		color: #061018;
	}

	.secondary-button {
		border: 1px solid var(--border);

		background: var(--bg-elevated);
		color: var(--text);
	}

	.secondary-button:hover {
		border-color: #34455b;
		color: var(--text-strong);
	}

	@media (max-width: 850px) {
		.about-hero,
		.story,
		.approach {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.about-hero {
			padding: 5rem 0;
		}

		.profile-terminal {
			max-width: 600px;
		}

		.section-heading {
			display: block;
		}

		.section-heading > p {
			margin-top: 1rem;
		}
	}

	@media (max-width: 650px) {
		.focus-grid {
			grid-template-columns: 1fr;
		}

		.output p {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
	}
</style>