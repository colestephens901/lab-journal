---
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<div>
			<strong>Cole Stephens</strong>
			<p>Homelab • Infrastructure • Networking • Linux</p>
		</div>

		<div class="footer-right">
			<span>© {year} Cole Stephens</span>
			<span class="separator">•</span>
			<span>Built with Astro & Markdown</span>
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: 5rem;
		border-top: 1px solid var(--border);
		background: rgba(13, 20, 30, 0.6);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		width: min(var(--max-width), calc(100% - 40px));
		margin: 0 auto;
		padding: 2rem 0;
		color: var(--muted);
		font-size: 0.85rem;
	}

	strong {
		color: var(--text);
	}

	p {
		margin: 0.2rem 0 0;
		font-family: Consolas, monospace;
		font-size: 0.75rem;
	}

	.footer-right {
		display: flex;
		gap: 0.45rem;
	}

	@media (max-width: 700px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}

		.footer-right {
			flex-wrap: wrap;
		}
	}
</style>