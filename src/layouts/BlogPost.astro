---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	heroImageCaption,
	type,
	tags,
} = Astro.props;

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'long',
		day: 'numeric',
		year: 'numeric',
		timeZone: 'UTC',
	}).format(date);

const typeLabel =
	type === 'project-writeup'
		? 'Project Write-up'
		: 'Lab Note';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${title} | Cole Stephens`}
			description={description}
		/>
	</head>

	<body>
		<Header />

		<main>
			<article>
				<header class="article-header">
					<a class="back" href="/blog/">
						← Back to Lab Journal
					</a>

					<div class="meta">
						<span
							class:list={[
								'type-badge',
								type === 'project-writeup'
									? 'project'
									: 'note',
							]}
						>
							{typeLabel}
						</span>

						<time datetime={pubDate.toISOString()}>
							{formatDate(pubDate)}
						</time>
					</div>

					<h1>{title}</h1>

					<p class="description">
						{description}
					</p>

					{
						tags.length > 0 && (
							<div class="tags">
								{tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
						)
					}

					{
						updatedDate && (
							<p class="updated">
								Last updated {formatDate(updatedDate)}
							</p>
						)
					}
				</header>

				{
					heroImage && (
						<figure class="hero-figure">
							<div class="hero-image-wrapper">
								<Image
									src={heroImage}
									alt={heroImageAlt ?? title}
									widths={[640, 960, 1280, 1600]}
									sizes="(max-width: 900px) 100vw, 1100px"
									loading="eager"
								/>
							</div>

							{
								heroImageCaption && (
									<figcaption>
										{heroImageCaption}
									</figcaption>
								)
							}
						</figure>
					)
				}

				<div class="article-divider"></div>

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 1120px;
	}

	article {
		padding: 6rem 0 2rem;
	}

	.article-header {
		max-width: 850px;
	}

	.back {
		display: inline-block;

		margin-bottom: 3rem;

		color: var(--muted);

		font-family: Consolas, monospace;
		font-size: 0.8rem;
		text-decoration: none;
	}

	.back:hover {
		color: var(--accent);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 1rem;

		margin-bottom: 1.5rem;
	}

	.type-badge {
		display: inline-flex;

		padding: 0.28rem 0.5rem;

		border: 1px solid var(--border);
		border-radius: 5px;

		font-family: Consolas, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.type-badge.note {
		border-color: rgba(56, 189, 248, 0.3);

		background: rgba(56, 189, 248, 0.09);
		color: var(--accent);
	}

	.type-badge.project {
		border-color: rgba(94, 234, 212, 0.3);

		background: rgba(94, 234, 212, 0.08);
		color: var(--success);
	}

	time,
	.updated {
		color: var(--muted);

		font-family: Consolas, monospace;
		font-size: 0.75rem;
	}

	h1 {
		max-width: 850px;
		margin: 0;

		font-size: clamp(3rem, 7vw, 5.4rem);
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.description {
		max-width: 750px;

		margin: 1.8rem 0 0;

		color: var(--muted);

		font-size: 1.15rem;
		line-height: 1.7;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;

		margin-top: 1.5rem;
	}

	.tags span {
		padding: 0.3rem 0.55rem;

		border: 1px solid var(--border);
		border-radius: 5px;

		background: var(--bg-soft);
		color: #aebdd0;

		font-family: Consolas, monospace;
		font-size: 0.72rem;
	}

	.updated {
		margin-top: 1.5rem;
	}

	.hero-figure {
		margin: 4rem 0 0;
	}

	.hero-image-wrapper {
		overflow: hidden;

		border: 1px solid var(--border);
		border-radius: 14px;

		background: var(--bg-elevated);

		box-shadow:
			0 30px 80px rgba(0, 0, 0, 0.25),
			0 0 0 1px rgba(255, 255, 255, 0.015);
	}

	.hero-image-wrapper :global(img) {
		display: block;

		width: 100%;
		height: auto;

		margin: 0;

		border: 0;
		border-radius: 0;

		background: transparent;
	}

	.hero-figure figcaption {
		max-width: 900px;

		margin: 0.8rem auto 0;

		color: #77889d;

		font-family: Consolas, monospace;
		font-size: 0.72rem;
		line-height: 1.55;
		text-align: center;
	}

	.article-divider {
		height: 1px;

		margin: 4rem 0;

		background: var(--border);
	}

	.prose {
		max-width: 760px;

		margin: 0 auto;

		color: #c4cfdd;

		font-size: 1.02rem;
		line-height: 1.85;
	}

	.prose :global(h2) {
		margin: 3.5rem 0 1rem;

		font-size: 2rem;
		letter-spacing: -0.025em;
	}

	.prose :global(h3) {
		margin: 2.5rem 0 0.8rem;

		font-size: 1.4rem;
	}

	.prose :global(p) {
		margin: 0 0 1.4rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.5rem;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose :global(blockquote) {
		margin: 2rem 0;
		padding: 1rem 1.3rem;

		border-left: 3px solid var(--accent);

		background: var(--accent-soft);
		color: var(--text);
	}

	.prose :global(blockquote p) {
		margin: 0;
	}

	.prose :global(a) {
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.prose :global(hr) {
		margin: 3rem 0;

		border: 0;
		border-top: 1px solid var(--border);
	}

	.prose :global(pre) {
		overflow-x: auto;

		margin: 2rem 0;
	}

	/*
	 * Standard Markdown images
	 *
	 * Example:
	 * ![Description](../../assets/blog/example.png)
	 */
	.prose :global(img) {
		display: block;

		max-width: 100%;
		height: auto;

		margin: 2.5rem auto;

		border: 1px solid var(--border);
		border-radius: 10px;

		background: var(--bg-elevated);

		box-shadow: 0 18px 50px rgba(0, 0, 0, 0.2);
	}

	/*
	 * Figure blocks with captions
	 */
	.prose :global(figure) {
		margin: 3rem 0;
	}

	.prose :global(figure img) {
		width: 100%;

		margin: 0;
	}

	.prose :global(figcaption) {
		margin-top: 0.8rem;

		color: #77889d;

		font-family: Consolas, monospace;
		font-size: 0.72rem;
		line-height: 1.55;
		text-align: center;
	}

	/*
	 * Wide figures can extend outside the normal
	 * article text column on larger displays.
	 *
	 * Use:
	 *
	 * <figure class="wide">
	 * ...
	 * </figure>
	 */
	.prose :global(figure.wide) {
		width: min(1000px, calc(100vw - 3rem));
		max-width: none;

		margin-left: 50%;

		transform: translateX(-50%);
	}

	/*
	 * Screenshot-style figures get a subtle
	 * technical-window treatment.
	 */
	.prose :global(figure.screenshot) {
		padding: 0.65rem;

		border: 1px solid var(--border);
		border-radius: 12px;

		background: #080d14;

		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
	}

	.prose :global(figure.screenshot img) {
		border-radius: 7px;

		box-shadow: none;
	}

	.prose :global(figure.screenshot figcaption) {
		padding: 0 0.5rem 0.15rem;
	}

	/*
	 * Optional two-image gallery.
	 */
	.prose :global(.image-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;

		width: min(1000px, calc(100vw - 3rem));

		margin: 3rem 0 3rem 50%;

		transform: translateX(-50%);
	}

	.prose :global(.image-grid figure) {
		margin: 0;
	}

	.prose :global(.image-grid img) {
		width: 100%;
		height: 100%;
		max-height: 500px;

		margin: 0;

		object-fit: cover;
	}

	@media (max-width: 800px) {
		main {
			max-width: 900px;
		}

		.prose :global(figure.wide),
		.prose :global(.image-grid) {
			width: 100%;

			margin-left: 0;

			transform: none;
		}

		.prose :global(.image-grid) {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 700px) {
		article {
			padding-top: 4rem;
		}

		.article-divider {
			margin: 3rem 0;
		}

		.hero-figure {
			margin-top: 3rem;
		}

		.hero-image-wrapper {
			border-radius: 10px;
		}

		.prose :global(img) {
			margin: 2rem auto;
			border-radius: 8px;
		}
	}
</style>