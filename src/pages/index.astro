---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="status">
					<span class="status-dot"></span>
					Technical Lab Journal
				</div>

				<p class="eyebrow">
					HOMELAB / INFRASTRUCTURE / NETWORKING / LINUX
				</p>

				<h1>
					Building, breaking,
					<span>and fixing infrastructure.</span>
				</h1>

				<p class="intro">
					I'm Cole Stephens. This is my technical lab journal where I document
					the projects I'm building, the problems I encounter, how I troubleshoot
					them, and what I learn along the way.
				</p>

				<div class="actions">
					<a class="button primary-button" href="/blog/">
						Read the Lab Journal
						<span aria-hidden="true">→</span>
					</a>

					<a class="button secondary-button" href="/about/">
						About Me
					</a>
				</div>
			</section>

			<section class="section">
				<div class="section-heading">
					<div>
						<p class="section-label">THE LAB</p>
						<h2>What I'm Working With</h2>
					</div>

					<p>
						Hands-on infrastructure projects built around a continuously
						evolving home lab environment.
					</p>
				</div>

				<div class="grid">
					<article>
						<div class="card-number">01</div>
						<h3>Virtualization</h3>
						<p>
							Proxmox VE, virtual machines, Linux containers, storage,
							backups, clustering, and infrastructure management.
						</p>
						<div class="tags">
							<span>Proxmox</span>
							<span>Linux</span>
							<span>ZFS</span>
						</div>
					</article>

					<article>
						<div class="card-number">02</div>
						<h3>Networking</h3>
						<p>
							OPNsense, VLANs, routing, DNS, VPNs, firewall policies,
							wireless networking, and troubleshooting.
						</p>
						<div class="tags">
							<span>OPNsense</span>
							<span>VLANs</span>
							<span>VPN</span>
						</div>
					</article>

					<article>
						<div class="card-number">03</div>
						<h3>Self-Hosting</h3>
						<p>
							Docker, reverse proxies, monitoring, media services,
							password management, and internal applications.
						</p>
						<div class="tags">
							<span>Docker</span>
							<span>Nginx</span>
							<span>DNS</span>
						</div>
					</article>

					<article>
						<div class="card-number">04</div>
						<h3>Automation & Monitoring</h3>
						<p>
							Home Assistant, Prometheus, Grafana, alerting, scripting,
							and automating repetitive infrastructure tasks.
						</p>
						<div class="tags">
							<span>Grafana</span>
							<span>Prometheus</span>
							<span>Automation</span>
						</div>
					</article>
				</div>
			</section>

			<section class="journal-preview">
				<div>
					<p class="section-label">LAB JOURNAL</p>
					<h2>Documenting the process, not just the result.</h2>

					<p>
						Each entry focuses on a real project or problem: the goal,
						the implementation, what went wrong, how I diagnosed it,
						and what I learned from the process.
					</p>
				</div>

				<div class="terminal">
					<div class="terminal-top">
						<span></span>
						<span></span>
						<span></span>
					</div>

					<div class="terminal-body">
						<p><span class="prompt">$</span> whoami</p>
						<p class="output">cole</p>

						<p><span class="prompt">$</span> cat current-focus.txt</p>
						<p class="output">
							virtualization<br />
							networking<br />
							observability<br />
							self-hosting<br />
							automation
						</p>

						<p>
							<span class="prompt">$</span>
							<span class="cursor">_</span>
						</p>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		max-width: 950px;
		padding: 8rem 0 7rem;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 2.5rem;
		padding: 0.4rem 0.7rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: rgba(16, 23, 34, 0.8);
		color: var(--muted);
		font-family: Consolas, monospace;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--success);
		box-shadow: 0 0 10px rgba(94, 234, 212, 0.65);
	}

	.eyebrow,
	.section-label {
		margin: 0 0 1rem;
		color: var(--accent);
		font-family: Consolas, monospace;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	h1 {
		max-width: 900px;
		margin: 0;
		font-size: clamp(3.5rem, 8vw, 6.7rem);
		line-height: 0.96;
		letter-spacing: -0.055em;
	}

	h1 span {
		color: #a6b6c9;
	}

	.intro {
		max-width: 760px;
		margin: 2rem 0 0;
		color: var(--muted);
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.75;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2.5rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		min-height: 46px;
		padding: 0.7rem 1.1rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.primary-button {
		border: 1px solid var(--accent);
		background: var(--accent);
		color: #061018;
	}

	.primary-button:hover {
		background: var(--accent-hover);
		color: #061018;
	}

	.secondary-button {
		border: 1px solid var(--border);
		background: var(--bg-elevated);
		color: var(--text);
	}

	.secondary-button:hover {
		border-color: #34455b;
		color: var(--text-strong);
	}

	.section {
		padding: 2rem 0 7rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 4rem;
		margin-bottom: 2rem;
	}

	.section-heading h2,
	.journal-preview h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3rem);
		letter-spacing: -0.035em;
	}

	.section-heading > p {
		max-width: 440px;
		margin: 0;
		color: var(--muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.grid article {
		position: relative;
		min-height: 270px;
		padding: 1.8rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.025),
				transparent
			),
			var(--bg-elevated);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease;
	}

	.grid article:hover {
		transform: translateY(-3px);
		border-color: #34455b;
	}

	.card-number {
		margin-bottom: 3rem;
		color: var(--accent);
		font-family: Consolas, monospace;
		font-size: 0.75rem;
	}

	.grid h3 {
		margin: 0 0 0.7rem;
		font-size: 1.45rem;
	}

	.grid p {
		max-width: 470px;
		margin: 0;
		color: var(--muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.4rem;
	}

	.tags span {
		padding: 0.3rem 0.55rem;
		border: 1px solid var(--border);
		border-radius: 5px;
		background: var(--bg-soft);
		color: #aebdd0;
		font-family: Consolas, monospace;
		font-size: 0.72rem;
	}

	.journal-preview {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 5rem;
		align-items: center;
		padding: 6rem 0;
		border-top: 1px solid var(--border);
	}

	.journal-preview > div:first-child > p:last-child {
		max-width: 520px;
		color: var(--muted);
		font-size: 1.05rem;
	}

	.terminal {
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: #060a0f;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
	}

	.terminal-top {
		display: flex;
		gap: 0.45rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--border);
		background: #0d131c;
	}

	.terminal-top span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #374151;
	}

	.terminal-body {
		min-height: 300px;
		padding: 1.4rem 1.6rem;
		font-family: Consolas, "Courier New", monospace;
		font-size: 0.9rem;
	}

	.terminal-body p {
		margin: 0 0 1rem;
	}

	.prompt {
		color: var(--accent);
	}

	.output {
		padding-left: 1.1rem;
		color: #93a4b8;
	}

	.cursor {
		color: var(--accent);
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (max-width: 850px) {
		.hero {
			padding: 5rem 0;
		}

		.section-heading {
			display: block;
		}

		.section-heading > p {
			margin-top: 1rem;
		}

		.journal-preview {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 650px) {
		h1 {
			font-size: clamp(3rem, 15vw, 4.5rem);
		}

		.grid {
			grid-template-columns: 1fr;
		}

		.grid article {
			min-height: auto;
		}

		.card-number {
			margin-bottom: 2rem;
		}
	}
</style>